# Optional: comma-separated browser origins allowed to call the API directly.
# The production app serves its frontend and API from the same origin, so this
# can remain unset unless you host a separate frontend.
# CORS_ORIGINS=https://your-frontend.example

# Optional Vite build-time override for a separately hosted API.
# Leave unset for Render's same-origin deployment, which uses /api.
# VITE_API_BASE_URL=https://your-api.example/api
